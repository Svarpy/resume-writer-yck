# Copy this file to ".env" and fill in your values. ".env" is git-ignored: never commit real secrets.

# ---- Server (resume_server) - the only component that talks to MongoDB -----------------
# Connection string of your MongoDB (Atlas "mongodb+srv://..." or local "mongodb://localhost:27017").
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=resume-writer
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Login token lifetime in hours.
JWT_EXPIRE_HOURS=168
# Where the API listens.
API_HOST=127.0.0.1
API_PORT=8765
# Largest accepted sample document upload (megabytes).
MAX_UPLOAD_MB=10

# ---- Client side (desktop app and MCP server) ------------------------------------------
# Address of the API the desktop app / MCP server talks to.
RW_API_URL=http://127.0.0.1:8765
# Personal access token for the MCP server (create it in the desktop app: Profile > Access Tokens).
RW_API_TOKEN=
# How long cached settings / default format are trusted before they are re-checked (seconds).
RW_CACHE_TTL=900
